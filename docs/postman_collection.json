{
  "info": {
    "name": "Job Portal API",
    "description": "Collection covering auth, jobs, applications, dashboard, and scraper endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "applicationId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Candidate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Candidate\",\n  \"email\": \"jane.candidate@example.com\",\n  \"password\": \"Secret123\",\n  \"role\": \"CANDIDATE\"\n}"
            }
          }
        },
        {
          "name": "Register Employer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Recruiter\",\n  \"email\": \"recruiter@acme.com\",\n  \"password\": \"Secret123\",\n  \"role\": \"EMPLOYER\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.candidate@example.com\",\n  \"password\": \"Secret123\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/forgot-password",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"jane.candidate@example.com\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "List Jobs (search/filter/paginate)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/jobs?search=engineer&location=Bengaluru&sort=newest&page=1&limit=10"
          }
        },
        {
          "name": "Get Job By Id",
          "request": { "method": "GET", "url": "{{baseUrl}}/jobs/{{jobId}}" }
        },
        {
          "name": "Create Job (Employer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('jobId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/jobs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_name\": \"Acme Corp\",\n  \"title\": \"QA Automation Engineer\",\n  \"location\": \"Bengaluru\",\n  \"work_mode\": \"HYBRID\",\n  \"employment_type\": \"FULL_TIME\",\n  \"salary_min\": 600000,\n  \"salary_max\": 900000,\n  \"experience_min\": 0,\n  \"experience_max\": 2,\n  \"skills\": [\"Selenium\", \"TestNG\", \"Java\"],\n  \"description\": \"Own manual and automation testing for our platform.\",\n  \"benefits\": \"Health insurance, WFH stipend\",\n  \"deadline\": \"2026-12-31\"\n}"
            }
          }
        },
        {
          "name": "Update Job",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/jobs/{{jobId}}",
            "body": { "mode": "raw", "raw": "{\n  \"salary_max\": 950000\n}" }
          }
        },
        {
          "name": "Close Job",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/jobs/{{jobId}}/close"
          }
        },
        {
          "name": "Delete Job",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/jobs/{{jobId}}"
          }
        },
        {
          "name": "Get Applicants for Job",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/jobs/{{jobId}}/applicants"
          }
        },
        {
          "name": "Apply to Job (Candidate)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/jobs/{{jobId}}/apply",
            "body": { "mode": "raw", "raw": "{\n  \"cover_letter\": \"I'd love to join your QA team.\"\n}" }
          }
        },
        {
          "name": "Save Job (Candidate)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/jobs/{{jobId}}/save"
          }
        },
        {
          "name": "Unsave Job (Candidate)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/jobs/{{jobId}}/save"
          }
        },
        {
          "name": "Get My Saved Jobs (Candidate)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/jobs/saved/me"
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "List My Applications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/applications?page=1&limit=10"
          }
        },
        {
          "name": "Update Application Status (Employer/Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/applications/{{applicationId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"SHORTLISTED\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard (role-scoped)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/dashboard"
          }
        }
      ]
    },
    {
      "name": "Scraper",
      "item": [
        {
          "name": "Trigger Scrape (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/scrape/jobs"
          }
        },
        {
          "name": "Get Scrape Logs (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/scrape/logs"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        { "name": "Health Check", "request": { "method": "GET", "url": "http://localhost:5000/health" } }
      ]
    }
  ]
}
